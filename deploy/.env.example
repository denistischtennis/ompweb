# ompweb :1338 environment. Copy to `.env` next to docker-compose.yml.
# Generate the hash with:  docker run --rm local/ompweb-master:0.7.4-mt.1 sh -c 'echo "<password>" | ompweb hash-password'
OMP_WEB_PASSWORD_HASH=scrypt$15$8$1$cjpSlPzQ3YkHzXNkPm8yuw$P9UYvbmAqKXa704AwMuGVfKkMYx3EejIzTybJDMbdDw
# Set together with a stored account profile to route that user's space through the VPN sidecar image (its entrypoint enforces the OpenVPN kill switch).
# OMP_WEB_VPN_IMAGE=
